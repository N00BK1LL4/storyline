/* Boss bar, top centre. 1 dp = 1 px of the 1080p reference. */
body { width: 100%; height: 100%; pointer-events: none; font-family: "Chakra Petch"; font-weight: bold; color: #f2f2f2; }

#root
{
    position: absolute; left: 0; right: 0; top: 96dp;
    display: flex; flex-direction: row; justify-content: center;
    opacity: 0; visibility: hidden;
    transition: opacity 0.25s cubic-out;
}
#root.on { opacity: 1; visibility: visible; }

#panel { width: 560dp; padding: 10dp 16dp; background-color: #12080ad0; border-width: 1dp; border-color: #ff4d3d55; }
#row { display: flex; flex-direction: row; justify-content: space-between; align-items: baseline; margin-bottom: 6dp; }
#name { font-size: 22dp; letter-spacing: 0.08em; }
#percent { font-size: 18dp; color: #ffb38a; }
#track { height: 10dp; background-color: #ffffff1c; }
#fill { height: 10dp; background-color: #ff4d3d; transition: width 0.3s cubic-out; }
#root.low #fill { background-color: #ffd23d; }
#note { display: block; margin-top: 6dp; font-family: "Roboto Mono"; font-weight: normal; font-size: 11dp; color: #c9a9a4; }

/* slim: a thin line with small text, no panel */
#root.slim { top: 36dp; opacity: 0; }
#root.slim.on { opacity: 0.8; }
#root.slim #panel { width: 320dp; padding: 0; background-color: transparent; border-width: 0; }
#root.slim #row { margin-bottom: 3dp; }
#root.slim #name { font-size: 14dp; letter-spacing: 0.04em; }
#root.slim #percent { font-size: 13dp; }
#root.slim #track, #root.slim #fill { height: 3dp; }
#root.slim #track { background-color: #00000080; }
#root.slim #note { display: none; }
